type Weather = 
 variant {
   daytime;
   nighttime;
   partlyCloudy;
 };
type Waypoint = 
 record {
   description: text;
   name: text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type SubmitOutcome = 
 variant {
   improved: LeaderboardEntryView;
   posted: LeaderboardEntryView;
   tooLow: record {needed: nat;};
   unchanged: LeaderboardEntryView;
 };
type SlotStatus = 
 variant {
   holding;
   live;
   queued;
 };
type ScoreBreakdown = 
 record {
   landingSmoothness: nat;
   speed: nat;
   total: nat;
 };
type Runway = 
 record {
   description: text;
   name: text;
 };
type Result = 
 variant {
   err: Error;
   ok;
 };
type QueueSlotView = 
 record {
   enemyFlag: FlagCode;
   id: nat;
   lockUntil: int;
   playerFlag: FlagCode;
   startAt: int;
   status: SlotStatus;
 };
type PrepareView = 
 record {
   amountE8s: nat64;
   destinationAccount: text;
   feeE8s: nat64;
   lockHours: nat;
   memo: Memo;
   queuePosition: nat;
   startAt: int;
 };
type PlayerId = principal;
type Plane__2 = 
 record {
   handling: text;
   id: PlaneId;
   name: text;
 };
type PlaneId = nat;
type Plane = 
 variant {
   cessna;
   gulfstream;
 };
type PlanId = nat;
type PaymentInfoView = 
 record {
   amountE8s: nat64;
   defaultEnemyFlag: FlagCode;
   defaultPlayerFlag: FlagCode;
   destinationAccount: text;
   feeE8s: nat64;
   lockHours: nat;
   maxQueue: nat;
 };
type Memo = nat64;
type LogId = nat;
type LeaderboardEntryView = 
 record {
   displayName: text;
   id: EntryId;
   planName: text;
   plane: Plane;
   playerId: principal;
   submittedAt: int;
   total: nat;
   weather: Weather;
 };
type FlightPlan = 
 record {
   departure: Runway;
   id: PlanId;
   landing: Runway;
   name: text;
   plane: Plane__2;
   routeDescription: text;
   waypoint: Waypoint;
   weather: Weather;
 };
type FlightLogView = 
 record {
   completedAt: int;
   id: LogId;
   planName: text;
   plane: Plane;
   playerId: PlayerId;
   score: ScoreBreakdown;
   weather: Weather;
 };
type FlagCode = text;
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type EntryId = nat;
type ConfirmView = 
 record {
   enemyFlag: FlagCode;
   id: nat;
   lockUntil: int;
   playerFlag: FlagCode;
   queuePosition: nat;
   startAt: int;
 };
type ActiveFlagsView = 
 record {
   enemyFlag: FlagCode;
   holder: opt principal;
   lockUntil: int;
   playerFlag: FlagCode;
   queued: nat;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  confirmGameChange: (blockIndex: nat64) -> (ConfirmView);
  getActiveGameFlags: () -> (ActiveFlagsView) query;
  getCallerUserRole: () -> (UserRole) query;
  getFlightLog: (logId: LogId) -> (opt FlightLogView) query;
  getFlightPlan: (planId: PlanId) -> (opt FlightPlan) query;
  getGameChangePaymentInfo: () -> (PaymentInfoView) query;
  isCallerAdmin: () -> (bool) query;
  listFlightLogs: () -> (vec FlightLogView) query;
  listFlightPlans: () -> (vec FlightPlan) query;
  listGameChangeQueue: () -> (vec QueueSlotView) query;
  listLeaderboard: () -> (vec LeaderboardEntryView) query;
  listPlanes: () -> (vec Plane__2) query;
  listWeather: () -> (vec Weather) query;
  prepareGameChange: (playerFlag: text, enemyFlag: text) -> (PrepareView);
  recordFlightLog: (completedAt: int, planName: text, plane: Plane, weather:
   Weather, score: ScoreBreakdown) -> (FlightLogView);
  submitLeaderboardScore: (displayName: text, planName: text, plane: 
   Plane, weather: Weather, total: nat) -> (SubmitOutcome);
}
